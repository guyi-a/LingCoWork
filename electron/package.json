{
  "name": "lingcowork-electron",
  "private": true,
  "version": "0.1.0",
  "description": "LingCoWork desktop application.",
  "author": "Wang Zhilin",
  "main": "out/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "dist:mac": "electron-builder --config electron-builder.yml --mac dir dmg --arm64",
    "dist:win": "electron-builder --config electron-builder.yml --win --x64",
    "postinstall": "node scripts/patch-electron-bundle-id.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
