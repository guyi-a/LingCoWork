{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingcowork.local/schemas/coding-eval-task.json",
  "title": "Coding Alpha task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "description", "type", "enabled", "baseline",
    "timeout_seconds", "fixture", "verify", "scoring"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "type": {"const": "fixture"},
    "enabled": {"type": "boolean"},
    "disabled_reason": {"type": "string", "minLength": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "reason"],
      "properties": {
        "included": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "command"],
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "command": {"type": "string", "minLength": 1}
      }
    },
    "verify": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1}
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forbidden_paths", "max_changed_files", "max_added_lines", "max_deleted_lines"],
      "properties": {
        "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "max_changed_files": {"type": "integer", "minimum": 1},
        "max_added_lines": {"type": "integer", "minimum": 0},
        "max_deleted_lines": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"not": {"required": ["disabled_reason"]}}
    },
    {
      "if": {"properties": {"enabled": {"const": false}}},
      "then": {"required": ["disabled_reason"]}
    }
  ]
}
